# verifier-kit devcontainer image — generated by devcontainer-kit; see .devcontainer/README.md.
#
# Layout (fixed order, so Docker's build cache is shared across repos):
#   1. House section — byte-identical in every kit-generated repo. Never edit it here.
#   2. Language sections — only the languages this repo selected, always in the same order.
#   3. Project section — this repo's extra apt packages and .devcontainer/project/image.sh.
# Versions: every tool installs its latest (Node, .NET: latest LTS). A repo pins a version in
# that language's own version file; pins are applied when the container is created.

# ─── 1. House section ──────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# System packages + GitHub CLI (official apt repo). BuildKit cache mounts keep .deb downloads
# and package lists out of the image; docker-clean is removed so those caches actually fill.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl gh git gnupg jq less ripgrep sqlite3 tmux unzip xz-utils zsh

# Weekly refresh marker (ISO week, written by initialize.sh). Every layer below rebuilds at most
# once a week, picking up the latest tools; initialize.sh re-pulls the upstream images that week.
COPY .refresh /tmp/devkit-refresh

# uv — the Python toolchain, in every container. Astral's installer rather than
# `COPY --from=ghcr.io/astral-sh/uv`: with a ghcr.io login stored in Docker Desktop, resolving
# that image needs the macOS keychain, which an SSH session (VS Code Remote-SSH) can't unlock.
# Placed after the refresh marker, so it fetches the current uv once a week.
RUN curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
    && uv --version

USER vscode
ENV HOME=/home/vscode \
    PATH=/home/vscode/.local/bin:${PATH}

# Cache directories owned by vscode, so the shared named cache volumes mount writable; ~/.ssh
# with the mode ssh expects, so a key bind-mounted into it lands on a vscode-owned directory.
RUN mkdir -p ~/.cache/uv ~/.cache/go-build ~/go/pkg/mod ~/.npm ~/.hex \
        ~/.cargo/registry ~/.cargo/git ~/.nuget/packages ~/.ssh \
    && chmod 700 ~/.ssh

# Claude Code — native installer (as vscode); it keeps itself current, post-start also updates it.
# Codex is installed at start instead: its installer keeps the binary under ~/.codex, which is a
# host mount at runtime.
RUN curl -fsSL https://claude.ai/install.sh | bash \
    && claude --version

# ─── 3. Project section ─────────────────────────────────────────────────────────────────────
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends python3
USER vscode
# Image-level steps this repo needs (runs as vscode; use sudo for root). Edit project/image.sh.
COPY --chmod=0755 project/image.sh /tmp/devkit-project-image.sh
RUN /tmp/devkit-project-image.sh \
    && sudo rm /tmp/devkit-project-image.sh
