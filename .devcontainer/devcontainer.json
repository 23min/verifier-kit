// verifier-kit devcontainer — generated by devcontainer-kit; change answers with `uvx copier update`.
// Project-specific steps belong in .devcontainer/project/. See .devcontainer/README.md.
{
  "name": "verifier-kit",
  "build": { "dockerfile": "Dockerfile", "context": "." },

  // Static name: identifiable in Docker Desktop, and a stale duplicate fails loudly on the name
  // clash instead of piling up under random names. The env file carries the host's git identity
  // (written by initialize.sh on the host).
  "runArgs": [
    "--name", "verifier-kit-dev",
    "--hostname", "verifier-kit-dev",
    "--env-file", "${localWorkspaceFolder}/.devcontainer/.host.env"
  ],

  // Only this repo is mounted. Sibling repos are listed explicitly (read-only by default).
  "workspaceFolder": "/workspaces/verifier-kit",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/verifier-kit,type=bind,consistency=cached",

  // Runs on the HOST: creates mount sources, the /tmp/.verifier-kit-* links the mounts use,
  // .host.env and the weekly refresh marker.
  "initializeCommand": "bash .devcontainer/initialize.sh",

  // Host state goes through /tmp/.verifier-kit-* links made by initialize.sh (Mac $HOME is always
  // right there); package caches are named volumes shared by every kit container.
  "mounts": [
    "source=/tmp/.verifier-kit-claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=/tmp/.verifier-kit-claude-plugins,target=/home/vscode/.claude/plugins,type=bind,consistency=cached",
    "source=/tmp/.verifier-kit-gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=/tmp/.verifier-kit-codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=/tmp/.verifier-kit-guidance,target=/home/vscode/.guidance,type=bind,consistency=cached",
    "source=devkit-cache-uv,target=/home/vscode/.cache/uv,type=volume",
    "source=devkit-cache-go-mod,target=/home/vscode/go/pkg/mod,type=volume",
    "source=devkit-cache-go-build,target=/home/vscode/.cache/go-build,type=volume"
  ],

  "features": {},

  "containerEnv": {
    "DEVKIT_SLUG": "verifier-kit",
    "UV_LINK_MODE": "copy"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "mhutchie.git-graph",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "golang.go"
      ],
      "settings": {
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        },
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
