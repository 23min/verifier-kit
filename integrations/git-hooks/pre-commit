#!/usr/bin/env bash
# Example git pre-commit hook: run the fast checks before every commit.
#   cp integrations/git-hooks/pre-commit .git/hooks/pre-commit
# or point git at this folder:  git config core.hooksPath integrations/git-hooks
#
# Git hooks are a convenience, not a gate: `git commit --no-verify` skips them, and an
# agent with a shell can too. CI is where the check is authoritative.
#
# This checks the working tree, not exactly what is staged; for a strict pre-commit,
# stash unstaged changes first (or use a hook manager that does).
exec "$(git rev-parse --show-toplevel)/verify"
