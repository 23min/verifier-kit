{
  "permissions": {
    "deny": [
      "Edit(/spec/**)",
      "Edit(/checks/**)",
      "Edit(/conformance/**)",
      "Edit(/mutation/**)",
      "Edit(/tools/**)",
      "Edit(/examples/**)",
      "Edit(/verify)",
      "Edit(/policy.yaml)",
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/examples/claude-code/hooks/stop-verify.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
