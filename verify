#!/usr/bin/env bash
# One entry point for every gate: CI, git hooks and agent hooks all call this script and
# nothing else, so they cannot drift apart. It builds spine and verify from tools/ into
# tools/bin/ with Go, then runs verify with its arguments; ./verify --help says what they do.
set -uo pipefail
here="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)" || exit 2
if ! command -v go >/dev/null; then
  out="go not found: ./verify builds spine and verify from tools/ with Go"
elif out="$(go -C "$here/tools" build -trimpath -o bin/ ./cmd/spine ./cmd/verify 2>&1)"; then
  exec "$here/tools/bin/verify" "$@"
fi
printf 'FAIL  spine and verify built\n'
printf '%s\n' "$out" | sed 's/^/      /'
printf -- '-- 1 step(s) failed: spine and verify built\n'
exit 1
